// Pathway Navigator — data model
//
// Design principles (see AGENTS.md §2 and docs/decision-log.md):
//   1. Provenance is NOT NULL. Every rule carries source URL, source date, verified date.
//   2. Ambiguity is encoded as enum values, never collapsed into booleans.
//   3. Rules are versioned via effectiveFrom/effectiveTo, never overwritten.
//   4. Display text is bilingual at the column level; rule logic is language-agnostic.
//
// NOTE: this schema has never been run through `prisma validate`. It was written
// without network access. Verify before trusting it.

generator client {
  // Prisma 7's current generator. The legacy `prisma-client-js` still works in
  // 7.x but is removed in 8.x, and it writes into node_modules, which hides
  // staleness. This one emits to a visible path instead.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts, not here. The
  // runtime client gets its connection via a driver adapter (src/lib/db.ts).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum QualificationCategory {
  SCHOOL
  PRE_UNIVERSITY
  SKILLS_CERT
  DIPLOMA
  DEGREE
}

enum AwardingBodyType {
  MOE
  MOHE
  DSD
  INSTITUTION
  FOREIGN
}

enum InstitutionType {
  PUBLIC_UNI
  PRIVATE_UNI
  POLYTECHNIC
  COMMUNITY_COLLEGE
  ILP
  TECHNICAL_INSTITUTE
  FOREIGN
}

/// Six values, deliberately. A missing MQA register record is ambiguous — it can
/// mean provisional accreditation not yet matured to full, the provider never
/// applied, the programme predates 1997, or accreditation was refused.
///
/// NOT_IN_REGISTER means: a search was performed and returned nothing.
/// UNKNOWN means: nobody has checked yet.
/// Collapsing these two is how a reference site quietly starts lying.
enum AccreditationStatus {
  FULL
  PROVISIONAL
  NOT_IN_REGISTER
  PRE_1997
  FAILED_ACCREDITATION
  UNKNOWN
}

/// Whether the MQF assigns this qualification a level at all.
///
/// Verified 2026-08-19 against the MQF 2nd Edition: the framework states
/// outright that foundation programmes, STPM, Matriculation and A Levels
/// "are not included in the Framework", and it never mentions SPM. Those are
/// real, widely held qualifications — they are simply outside the framework.
///
/// NOT_IN_FRAMEWORK means: checked, and MQA deliberately assigns no level.
/// UNKNOWN means: nobody has verified this row against a source document.
/// Collapsing those two into a plausible-looking integer is how a reference
/// site starts asserting things its own sources refuse to assert. Same
/// discipline as AccreditationStatus — see AGENTS.md §7.
/// How we know the date attached to a source document.
///
/// Added after entering the first real institution. UTHM's credit transfer
/// guidelines carry no printed date across eleven pages — the only date
/// available was PDF file metadata, which says when the file was exported, not
/// when the policy took effect. Storing that in the same column as a date
/// printed on a document makes the two indistinguishable.
///
/// PRINTED_ON_DOCUMENT is the only basis strong enough to reason about
/// supersession ("this policy replaced that one"). The others are weaker
/// evidence and the UI must not present them as the policy's own date.
enum SourceDateBasis {
  PRINTED_ON_DOCUMENT
  FILE_METADATA
  PAGE_PUBLISHED
  UNDATED
}

enum MqfStatus {
  ASSIGNED
  NOT_IN_FRAMEWORK
  UNKNOWN
}

/// CREDIT_TRANSFER and CREDIT_EXEMPTION are NOT the same thing and the difference
/// costs students a semester: an exemption lets you skip a subject, but the credits
/// may not count toward graduation, so the student still needs another elective to
/// reach the required credit hours.
///
/// Making this a first-class field forces the UI to surface the distinction.
/// No existing Malaysian site explains it clearly.
enum TransferType {
  DIRECT_ENTRY
  CREDIT_TRANSFER
  CREDIT_EXEMPTION
  APEL_C
  APEL_A
  NONE
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

/// A KIND of qualification, not an instance held by a person.
model Qualification {
  id   String @id @default(cuid())
  slug String @unique

  nameEn String
  nameMs String

  /// The spine of the whole system — but nullable, because not every
  /// qualification has one. Read it together with `mqfStatus`; a level is only
  /// a claim about the framework when the status is ASSIGNED.
  ///
  /// A level may also be present while the status is UNKNOWN: that is a drafted
  /// value nobody has checked yet, and the UI must not render it as fact.
  mqfLevel Int?

  mqfStatus MqfStatus @default(UNKNOWN)

  category         QualificationCategory
  awardingBodyType AwardingBodyType

  typicalDurationMonthsMin Int?
  typicalDurationMonthsMax Int?

  programmes    Programme[]
  rulesFromHere ProgressionRule[] @relation("RuleFromQualification")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mqfLevel])
  @@index([mqfStatus])
  @@index([category])
}

model Institution {
  id   String @id @default(cuid())
  slug String @unique

  nameEn String
  nameMs String

  type  InstitutionType
  state String?

  /// Link back to the Malaysian Qualifications Register provider entry.
  mqrProviderRef String?

  /// Institution-wide transfer policy, where one exists. Per-programme rules
  /// live on ProgressionRule; this is the umbrella document.
  policySourceUrl      String?
  policyDocumentDate   DateTime?
  /// NULL only when there is no policy document at all. Same discipline as
  /// ProgressionRule.sourceDateBasis.
  policyDateBasis      SourceDateBasis?

  programmes Programme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([state])
}

/// A specific offering at a specific institution — the thing a student applies to.
model Programme {
  id   String @id @default(cuid())
  slug String

  institutionId   String
  qualificationId String

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Restrict)

  nameEn String
  nameMs String

  /// v1 restricts this to computing/IT. Widen only after coverage is deep.
  field String

  mqrRecordUrl        String?
  accreditationStatus AccreditationStatus @default(UNKNOWN)

  /// Needed to resolve percentage caps into absolute credit numbers.
  totalCredits   Int?
  durationMonths Int?

  rulesToHere ProgressionRule[] @relation("RuleToProgramme")
  rulesFromHere ProgressionRule[] @relation("RuleFromProgramme")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, slug])
  @@index([field])
  @@index([accreditationStatus])
}

/// The edge in the graph. This is the actual product.
model ProgressionRule {
  id String @id @default(cuid())

  /// Exactly one of fromQualificationId / fromProgrammeId must be set.
  /// Prisma cannot express this; enforce with a raw CHECK constraint in a
  /// migration, and with a validation function in src/lib.
  fromQualificationId String?
  fromProgrammeId     String?
  toProgrammeId       String

  fromQualification Qualification? @relation("RuleFromQualification", fields: [fromQualificationId], references: [id], onDelete: Restrict)
  fromProgramme     Programme?     @relation("RuleFromProgramme", fields: [fromProgrammeId], references: [id], onDelete: Restrict)
  toProgramme       Programme      @relation("RuleToProgramme", fields: [toProgrammeId], references: [id], onDelete: Restrict)

  transferType TransferType

  /// Nullable because institutions state caps either as a percentage of total
  /// programme credits or as an absolute number. Some state neither.
  maxTransferPercent Decimal? @db.Decimal(5, 2)
  maxTransferCredits Int?

  minimumCgpa Decimal? @db.Decimal(3, 2)

  /// Structured, never free text — free text cannot power the eligibility checker.
  ///
  /// The shape originally documented here assumed SPM-style entry requirements
  /// (subject grades, credits, must-pass subjects). The first real policy
  /// entered — UTHM's credit transfer guidelines — needed none of those keys.
  /// Credit transfer rules are about course equivalence, not school subjects:
  /// {
  ///   "tier": "Category I (Table 1)",
  ///   "minCourseGrade": "C+",
  ///   "minSyllabusSimilarityPercent": 80,
  ///   "sourceProgrammeMustBeAccredited": true,
  ///   "applicationWindow": "first semester of study only",
  ///   "notEligible": ["failed the prior programme"]
  /// }
  ///
  /// Both shapes are legitimate — DIRECT_ENTRY rules will look like the first,
  /// CREDIT_TRANSFER rules like the second. Do NOT unify them prematurely; the
  /// checker should branch on transferType. See docs/decision-log.md 2026-08-19.
  requirements Json

  // --- Provenance. All NOT NULL, deliberately. See AGENTS.md §2. ---
  /// Where this rule was read from.
  sourceUrl String
  /// The date on the institution's own document — NULL when the document
  /// carries no date at all and none could be recovered. Always read together
  /// with `sourceDateBasis`; a date alone does not say how strong it is.
  sourceDocumentDate DateTime?

  /// How `sourceDocumentDate` was obtained. UNDATED requires the date to be
  /// NULL; every other basis requires it to be present. Enforced by the
  /// `ProgressionRule_source_date_matches_basis` CHECK constraint.
  sourceDateBasis SourceDateBasis
  /// When a human last confirmed this is still current.
  verifiedOn DateTime
  /// Drives the admin re-verification queue.
  recheckDueOn DateTime

  // --- Intake versioning. Never edit history; close a row and add a new one. ---
  effectiveFrom DateTime
  /// Null means "current".
  effectiveTo DateTime?

  caveats Caveat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromQualificationId, effectiveTo])
  @@index([fromProgrammeId, effectiveTo])
  @@index([toProgrammeId])
  @@index([recheckDueOn])
}

/// Free text, deliberately. This is where the hard ceiling gets encoded:
/// per-course transfer decisions are made by faculties case-by-case and are
/// never published. Institutional guidelines say outright that the faculty
/// reserves the right to determine approval for each course applied for.
///
/// Caveats render as VISIBLE WARNINGS on the page, not as fine print.
model Caveat {
  id String @id @default(cuid())

  ruleId String
  rule   ProgressionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  textEn String
  textMs String

  /// Higher = more prominent in the UI.
  severity Int @default(1)

  createdAt DateTime @default(now())

  @@index([ruleId])
}
