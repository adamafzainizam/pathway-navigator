# Copy this file to `.env` and fill in the values.
# `.env` describes DEVELOPMENT ONLY. Production values live in Vercel.
#
# WARNING: standalone scripts silently use this file's DATABASE_URL unless you
# override it inline on the command line. dotenv does not overwrite an
# already-set variable. To target another database:
#
#   DATABASE_URL="postgres://...other..." npx tsx scripts/whatever.ts

# Neon — use your DEVELOPMENT branch, never the production branch.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public site URL, used for canonical tags, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default locale. Bilingual from day one — see docs/seo.md
NEXT_PUBLIC_DEFAULT_LOCALE="ms"

# Cron authorization for scheduled re-verification reminders (Week 5+).
# Generate with: openssl rand -base64 32
CRON_SECRET=""
